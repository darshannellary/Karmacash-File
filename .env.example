# Copy to .env.local for local runs; set the same names in Vercel → Settings → Environment Variables.

# "live" turns off test mode. Leave unset until the NBFC's services are connected.
KARMACASH_MODE=

# Signs the application cookie. Any long random string; required in live mode.
SESSION_SECRET=

# Resend (resend.com) API key. When set, email codes and notifications are really sent.
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Defaults to Karmacash <noreply@karmacashai.com>.
EMAIL_FROM=
